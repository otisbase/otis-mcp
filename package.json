{
  "name": "otis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent-only business records on Cloudflare",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev --var DO_JURISDICTION:local",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "agents": "0.28.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.6",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/otisbase/otis-mcp.git"
  },
  "homepage": "https://otisbase.com"
}
